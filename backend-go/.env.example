# Porta em que a API HTTP sobe
APP_PORT=8080

# development | production
APP_ENV=development

# String de conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:your_password@localhost:5432/mental_health?sslmode=disable

# Segredo usado para assinar/validar os tokens JWT (gere um valor aleatório forte)
JWT_SECRET=your_jwt_secret_here

# Asaas (gateway de pagamento) - ambiente sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=your_asaas_sandbox_key

# Token compartilhado usado para validar a autenticidade dos webhooks recebidos do Asaas
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token
